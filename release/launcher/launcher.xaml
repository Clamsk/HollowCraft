<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HollowCraft · 空洞 × Minecraft" Width="1120" Height="820" MinWidth="960" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#091321" Foreground="#F1F0E8" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#101F30"/><SolidColorBrush x:Key="Line" Color="#334D59"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF1E7"/><Setter Property="Background" Value="#1D3440"/><Setter Property="BorderBrush" Value="#44626A"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#345660"/><Setter TargetName="Plate" Property="BorderBrush" Value="#8DD0C5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1B29"/><Setter Property="Foreground" Value="#F1F0E8"/><Setter Property="BorderBrush" Value="#45626C"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#122534"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E1E8E7"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#CEDDDA"/><Setter Property="Background" Value="#142B3A"/><Setter Property="Padding" Value="20,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="#375461" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#29434C"/><Setter TargetName="Tab" Property="BorderBrush" Value="#B5CF91"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEC1C5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 </Window.Resources>
 <Grid TextElement.Foreground="#F1F0E8" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13">
  <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
  <Border Background="#B2091422"/>
  <Grid Margin="34,24,34,18"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="HOLLOWCRAFT" FontFamily="Georgia" FontSize="35" FontWeight="Bold" Foreground="#F4F1E2"/><TextBlock Text="方块之力，深入圣巢" FontSize="16" Margin="2,7,0,6" Foreground="#BCD2BE"/><TextBlock Text="NATIVE 1.0.0   /   HOLLOW KNIGHT × MINECRAFT" FontSize="10" Foreground="#9AB1BC"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6" BorderBrush="#6A8D84" BorderThickness="1" CornerRadius="12"><TextBlock Text="单进程 · 独立 Mod" Foreground="#C8E4C5" FontSize="11"/></Border></Grid>
   <Border Grid.Row="1" Background="#ED0C1B2A" BorderBrush="#405965" BorderThickness="1" CornerRadius="8" Padding="18,14">
    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
     <TabItem x:Name="PlayTab" Header="冒险"><Grid Margin="8,22,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,32,0"><TextBlock Text="选择你的旅程" FontSize="23" Foreground="#F0EEDA"/><TextBlock Text="用熟悉的方块、武器与生存系统，探索圣巢。" Style="{StaticResource Muted}" Margin="0,10,0,20"/><Button x:Name="PlayButton" Content="继续冒险　→" FontSize="18" Padding="18,16" Background="#506747" BorderBrush="#A4BC83" HorizontalContentAlignment="Left"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="InstallButton" Content="安装 / 更新" Margin="0,0,12,0"/><Button x:Name="CloseButton" Content="关闭独立版"/></StackPanel><TextBlock Text="已有存档将保留当前背包；初始配装用于新存档和每场 Boss 录制。" Style="{StaticResource Muted}" Margin="0,18,0,0"/><TextBlock Text="A / D 移动　空格跳跃　E 背包&#x0a;F 切换副手　F3 + F4 切换模式" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#A5203542" BorderBrush="#38525D" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="生存规则" FontSize="19" Foreground="#E5E8CF"/><CheckBox x:Name="KeepInventory" Content="死亡后保留背包与装备"/><TextBlock Text="关闭后，死亡物品掉在原场景，返回可拾取。" Style="{StaticResource Muted}" FontSize="12"/><CheckBox x:Name="AutomaticWater" Content="自动落地水（生存 ≥ 12 格）"/><TextBlock Text="需要背包有水桶；教程开场也会触发。&#x0a;创造模式 > 12 格仍触发超英落地。" Style="{StaticResource Muted}" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="收水等待" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="WaterDelay" Width="105"/></StackPanel><TextBlock Text="修改规则后，重新启动游戏生效。" Style="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border>
     </Grid></TabItem>
     <TabItem x:Name="LoadoutTab" Header="初始配装"><Grid Margin="4,14,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="配装方案" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="Preset" Width="178"/><Button x:Name="ApplyPreset" Content="载入预设" Margin="10,0,0,0"/><TextBlock Text="点击任意槽位，在物品库中挑选；右键清空。" Style="{StaticResource Muted}" Margin="18,4,0,0"/></DockPanel>
      <Grid Grid.Row="1" Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="护甲与副手" Foreground="#C9D7B0" Margin="0,0,0,8"/><StackPanel x:Name="ArmorSlots" Orientation="Horizontal"/><TextBlock Text="头盔　胸甲　护腿　靴子" FontSize="10" Foreground="#A8BEC2" Margin="0,6,0,16"/><StackPanel Orientation="Horizontal"><StackPanel x:Name="OffhandSlot"/><TextBlock Text="副手" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="格子里的数字表示数量。&#x0a;药水与附魔书会保留所选变体。" Style="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="背包" Foreground="#C9D7B0" Margin="0,0,0,7"/><UniformGrid x:Name="BackpackSlots" Columns="9" Rows="3"/><TextBlock Text="快捷栏　1 — 9" Foreground="#C9D7B0" Margin="0,13,0,7"/><UniformGrid x:Name="HotbarSlots" Columns="9" Rows="1"/></StackPanel></Grid>
      <CheckBox x:Name="ApplyExisting" Grid.Row="2" Content="也应用到已有存档（替换背包与装备，每份存档对本次保存只应用一次）" FontSize="12"/>
     </Grid></TabItem>
     <TabItem x:Name="CatalogTab" Header="创造物品库"><Grid Margin="4,14,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><ComboBox x:Name="Category" Width="174"/><TextBox x:Name="Search" Margin="10,0,12,0" MinWidth="260" ToolTip="搜索中文名、英文名或物品 ID"/><TextBlock x:Name="CatalogCount" VerticalAlignment="Center" Foreground="#ABC0C2"/></DockPanel>
      <DockPanel Grid.Row="1" Margin="0,10,0,10"><TextBlock x:Name="TargetHint" Text="目标：快捷栏 1" Foreground="#D4E4BA" VerticalAlignment="Center"/><TextBlock Text="数量" VerticalAlignment="Center" Margin="18,0,8,0"/><TextBox x:Name="Quantity" Text="64" Width="58" Padding="5,3"/><Button x:Name="BackToLoadout" Content="返回配装" Padding="10,5" Margin="14,0,0,0"/><TextBlock Text="点击物品放入目标槽位" Foreground="#9DB4BD" Margin="16,0,0,0" VerticalAlignment="Center"/></DockPanel>
      <UniformGrid Grid.Row="2" x:Name="CatalogGrid" Columns="12" Rows="6" VerticalAlignment="Center"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button x:Name="PrevPage" Content="← 上一页" Padding="16,5"/><TextBlock x:Name="PageHint" Text="1 / 1" Margin="18,0" VerticalAlignment="Center"/><Button x:Name="NextPage" Content="下一页 →" Padding="16,5"/></StackPanel>
     </Grid></TabItem>
     <TabItem x:Name="BossTab" Header="Boss 录制"><StackPanel Margin="12,25"><TextBlock Text="准备一场对决" FontSize="24" Foreground="#F0EEDA"/><TextBlock Text="每场使用独立存档、生存模式与当前配装，方便快速录制。" Style="{StaticResource Muted}" Margin="0,10,0,20"/><ComboBox x:Name="BossChoice" MinWidth="420" HorizontalAlignment="Left"/><ComboBox x:Name="BossLevel" Width="210" HorizontalAlignment="Left" Margin="0,14,0,22"/><Button x:Name="RecordButton" Content="进入战斗　→" HorizontalAlignment="Left" Padding="30,13" Background="#506747" BorderBrush="#A4BC83"/><TextBlock Text="F5 重新挑战　F6 返回万神殿　F8 隐藏提示" Style="{StaticResource Muted}" Margin="0,20,0,0"/></StackPanel></TabItem>
    </TabControl>
   </Border>
   <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="准备就绪" Foreground="#D2E5B8" TextWrapping="Wrap"/><TextBox x:Name="Details" Text="仅启动空洞，无需运行 Minecraft 或 Java。" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,3" FontSize="10" Foreground="#9BB3BE" MaxHeight="35" VerticalScrollBarVisibility="Auto"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="保存配置" Padding="20,6"/><TextBlock Text="produced by clamsk" Foreground="#C6D4BC" FontFamily="Georgia" FontSize="11" HorizontalAlignment="Right" Margin="16,8,0,0"/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
